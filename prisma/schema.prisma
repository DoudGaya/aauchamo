  subtotal           Decimal    @db.Decimal(18, 2)
  taxTotal           Decimal    @default(0) @db.Decimal(18, 2)
  discountTotal      Decimal    @default(0) @db.Decimal(18, 2)
  total              Decimal    @db.Decimal(18, 2)
  paidTotal          Decimal    @default(0) @db.Decimal(18, 2)
  outstandingTotal   Decimal    @default(0) @db.Decimal(18, 2)
  officerId          String
  postedAt           DateTime   @default(now()) @db.Timestamptz(3)
  cancelledAt        DateTime?  @db.Timestamptz(3)
  cancellationReason String?
  reversedSaleId     String?
  version            Int        @default(1)
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)

  company      Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  station      Station             @relation(fields: [stationId], references: [id], onDelete: Restrict)
  businessUnit BusinessUnit        @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  agent        Agent?              @relation(fields: [agentId], references: [id], onDelete: Restrict)
  posSession   POSSession?         @relation(fields: [posSessionId], references: [id], onDelete: Restrict)
  reversedSale Sale?               @relation("SaleReversal", fields: [reversedSaleId], references: [id], onDelete: Restrict)
  reversals    Sale[]              @relation("SaleReversal")
  lines        SaleLine[]
  allocations  PaymentAllocation[]
  refunds      Refund[]
  outstanding  OutstandingPayment?

  @@unique([companyId, saleNumber])
  @@index([stationId, postedAt, status])
  @@index([customerId, postedAt])
  @@map("sales")
}

model SaleLine {
  id               String  @id @default(cuid())
  saleId           String
  productId        String
  productCode      String
  productName      String
  unitCode         String
  quantity         Decimal @db.Decimal(18, 3)
  unitPrice        Decimal @db.Decimal(18, 2)
  costPrice        Decimal @default(0) @db.Decimal(18, 2)
  taxRate          Decimal @default(0) @db.Decimal(7, 4)
  taxAmount        Decimal @default(0) @db.Decimal(18, 2)
  discountAmount   Decimal @default(0) @db.Decimal(18, 2)
  lineTotal        Decimal @db.Decimal(18, 2)
  quantityRefunded Decimal @default(0) @db.Decimal(18, 3)

  sale        Sale         @relation(fields: [saleId], references: [id], onDelete: Restrict)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  refundLines RefundLine[]

  @@index([saleId])
  @@map("sale_lines")
}

model Payment {
  id              String    @id @default(cuid())
  companyId       String
  stationId       String
  customerId      String?
  paymentMethodId String
  paymentNumber   String
  amount          Decimal   @db.Decimal(18, 2)
  reference       String?
  terminalId      String?
  receivedById    String
  receivedAt      DateTime  @default(now()) @db.Timestamptz(3)
  reversedAt      DateTime? @db.Timestamptz(3)
  reversalReason  String?

  company       Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  station       Station             @relation(fields: [stationId], references: [id], onDelete: Restrict)
  customer      Customer?           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod       @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  allocations   PaymentAllocation[]

  @@unique([companyId, paymentNumber])
  @@index([stationId, receivedAt])
  @@index([reference])
  @@map("payments")
}

model PaymentAllocation {
  id        String   @id @default(cuid())
  paymentId String
  saleId    String
  amount    Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@unique([paymentId, saleId])
  @@index([saleId])
  @@map("payment_allocations")
}

model OutstandingPayment {
  id          String    @id @default(cuid())
  saleId      String    @unique
  original    Decimal   @db.Decimal(18, 2)
  outstanding Decimal   @db.Decimal(18, 2)
  dueAt       DateTime? @db.Date
  settledAt   DateTime? @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@index([outstanding, dueAt])
  @@map("outstanding_payments")
}

model Refund {
  id               String       @id @default(cuid())
  companyId        String
  stationId        String
  saleId           String
  customerId       String
  paymentMethodId  String
  refundNumber     String
  status           RefundStatus @default(POSTED)
  amount           Decimal      @db.Decimal(18, 2)
  reason           String
  returnToStock    Boolean      @default(true)
  paymentReference String?
  requestedById    String
  approvedById     String?
  postedAt         DateTime?    @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  station       Station       @relation(fields: [stationId], references: [id], onDelete: Restrict)
  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Restrict)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  lines         RefundLine[]

  @@unique([companyId, refundNumber])
  @@index([saleId, status])
  @@map("refunds")
}

model RefundLine {
  id         String  @id @default(cuid())
  refundId   String
  saleLineId String
  productId  String
  quantity   Decimal @db.Decimal(18, 3)
  amount     Decimal @db.Decimal(18, 2)

  refund   Refund   @relation(fields: [refundId], references: [id], onDelete: Restrict)
  saleLine SaleLine @relation(fields: [saleLineId], references: [id], onDelete: Restrict)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([refundId, saleLineId])
  @@map("refund_lines")
}

model CargoLocation {
  id        String   @id @default(cuid())
  companyId String
  code      String
  name      String
  color     String   @default("#000000")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@map("cargo_locations")
}

model CargoShipment {
  id              String      @id @default(cuid())
  companyId       String
  stationId       String
  customerId      String
  awbNumber       String
  senderName      String
  senderPhone     String
  receiverName    String
  receiverPhone   String
  receiverAddress String?
  origin          String
  destination     String
  weightKg        Decimal     @db.Decimal(12, 3)
  pieces          Int
  commodity       String
  airline         String?
  flightNumber    String?
  flightDate      DateTime?   @db.Date
  handlingNotes   String?
  declaredValue   Decimal?    @db.Decimal(18, 2)
  isFragile       Boolean     @default(false)
  status          CargoStatus @default(DRAFT)
  labelVersion    Int         @default(1)
  reprintCount    Int         @default(0)
  createdById     String
  dispatchedAt    DateTime?   @db.Timestamptz(3)
  deliveredAt     DateTime?   @db.Timestamptz(3)
  version         Int         @default(1)
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  station  Station            @relation(fields: [stationId], references: [id], onDelete: Restrict)
  customer Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  events   CargoStatusEvent[]

  @@unique([companyId, awbNumber])
  @@index([stationId, status, createdAt])
  @@index([customerId, createdAt])
  @@map("cargo_shipments")
}

model CargoStatusEvent {
  id             String       @id @default(cuid())
  shipmentId     String
  previousStatus CargoStatus?
  status         CargoStatus
  location       String?
  notes          String?
  changedById    String
  occurredAt     DateTime     @default(now()) @db.Timestamptz(3)

  shipment CargoShipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  @@index([shipmentId, occurredAt])
  @@map("cargo_status_events")
}

model Agent {
  id            String      @id @default(cuid())
  companyId     String
  homeStationId String
  customerId    String?     @unique
  agentNumber   String
  name          String
  contactName   String
  phone         String
  email         String?
  address       String?
  creditLimit   Decimal     @default(0) @db.Decimal(18, 2)
  status        AgentStatus @default(ACTIVE)
  version       Int         @default(1)
  createdById   String
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  homeStation Station         @relation(fields: [homeStationId], references: [id], onDelete: Restrict)
  customer    Customer?       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  wallet      WalletAccount?
  sales       Sale[]
  bookings    TicketBooking[]

  @@unique([companyId, agentNumber])
  @@index([companyId, name, status])
  @@map("agents")
}

model WalletAccount {
  id        String   @id @default(cuid())
  agentId   String   @unique
  balance   Decimal  @default(0) @db.Decimal(18, 2)
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  agent   Agent         @relation(fields: [agentId], references: [id], onDelete: Restrict)
  entries WalletEntry[]

  @@map("wallet_accounts")
}

model WalletEntry {
  id              String          @id @default(cuid())
  companyId       String
  stationId       String
  walletAccountId String
  paymentMethodId String?
  entryNumber     String
  type            WalletEntryType
  amount          Decimal         @db.Decimal(18, 2)
  balanceAfter    Decimal         @db.Decimal(18, 2)
  referenceType   String
  referenceId     String
  externalRef     String?
  reason          String?
  postedById      String
  reversedEntryId String?
  postedAt        DateTime        @default(now()) @db.Timestamptz(3)

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  station       Station        @relation(fields: [stationId], references: [id], onDelete: Restrict)
  walletAccount WalletAccount  @relation(fields: [walletAccountId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  reversedEntry WalletEntry?   @relation("WalletReversal", fields: [reversedEntryId], references: [id], onDelete: Restrict)
  reversals     WalletEntry[]  @relation("WalletReversal")

  @@unique([companyId, entryNumber])
  @@index([walletAccountId, postedAt])
  @@index([referenceType, referenceId])
  @@map("wallet_entries")
}

model FinancialAccount {
  id              String   @id @default(cuid())
  companyId       String
  code            String
  name            String
  accountType     String
  paymentMethodId String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  paymentMethod   PaymentMethod?   @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  entries         CashbookEntry[]
  cashSessions    CashSession[]
  reconciliations Reconciliation[]

  @@unique([companyId, code])
  @@map("financial_accounts")
}

model FinancialCategory {
  id        String           @id @default(cuid())
  companyId String
  code      String
  name      String
  type      FinanceDirection
  isActive  Boolean          @default(true)

  company Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  entries CashbookEntry[]

  @@unique([companyId, code])
  @@map("financial_categories")
}

model CashbookEntry {
  id                String           @id @default(cuid())
  companyId         String
  stationId         String
  businessUnitId    String?
  accountId         String
  categoryId        String
  paymentMethodId   String?
  entryNumber       String
  direction         FinanceDirection
  amount            Decimal          @db.Decimal(18, 2)
  description       String
  sourceType        String
  sourceId          String
  externalReference String?
  status            PostingStatus    @default(POSTED)
  postedById        String
  approvedById      String?
  postedAt          DateTime?        @db.Timestamptz(3)
  reversalOfId      String?
  reversalReason    String?
  version           Int              @default(1)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)

  company       Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  station       Station           @relation(fields: [stationId], references: [id], onDelete: Restrict)
  businessUnit  BusinessUnit?     @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  account       FinancialAccount  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category      FinancialCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod?    @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  reversalOf    CashbookEntry?    @relation("CashbookReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals     CashbookEntry[]   @relation("CashbookReversal")

  @@unique([companyId, entryNumber])
  @@unique([companyId, sourceType, sourceId, direction, accountId])
  @@index([stationId, status, createdAt])
  @@index([accountId, postedAt])
  @@map("cashbook_entries")
}

model FinancialPeriod {
  id         String    @id @default(cuid())
  companyId  String
  name       String
  startsAt   DateTime  @db.Date
  endsAt     DateTime  @db.Date
  isClosed   Boolean   @default(false)
  closedById String?
  closedAt   DateTime? @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, startsAt, endsAt])
  @@index([companyId, isClosed])
  @@map("financial_periods")
}

model CashSession {
  id             String            @id @default(cuid())
  stationId      String
  accountId      String
  openedById     String
  openedAt       DateTime          @default(now()) @db.Timestamptz(3)
  openingBalance Decimal           @db.Decimal(18, 2)
  status         CashSessionStatus @default(OPEN)
  closedById     String?
  closedAt       DateTime?         @db.Timestamptz(3)
  expected       Decimal?          @db.Decimal(18, 2)
  counted        Decimal?          @db.Decimal(18, 2)
  variance       Decimal?          @db.Decimal(18, 2)

  station Station          @relation(fields: [stationId], references: [id], onDelete: Restrict)
  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([stationId, status, openedAt])
  @@map("cash_sessions")
}

model Reconciliation {
  id               String   @id @default(cuid())
  companyId        String
  accountId        String
  statementDate    DateTime @db.Date
  statementBalance Decimal  @db.Decimal(18, 2)
  systemBalance    Decimal  @db.Decimal(18, 2)
  difference       Decimal  @db.Decimal(18, 2)
  status           String
  reconciledById   String
  reconciledAt     DateTime @default(now()) @db.Timestamptz(3)
  notes            String?

  company Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, statementDate])
  @@map("reconciliations")
}

model TicketBooking {
  id             String        @id @default(cuid())
  companyId      String
  stationId      String
  businessUnitId String?
  customerId     String
  agentId        String?
  bookingNumber  String
  pnr            String
  passengerName  String
  origin         String
  destination    String
  airline        String
  flightNumber   String?
  travelDate     DateTime      @db.Date
  fare           Decimal       @db.Decimal(18, 2)
  sellingPrice   Decimal       @db.Decimal(18, 2)
  profit         Decimal       @db.Decimal(18, 2)
  status         BookingStatus @default(RESERVED)
  createdById    String
  ticketedAt     DateTime?     @db.Timestamptz(3)
  cancelledAt    DateTime?     @db.Timestamptz(3)
  version        Int           @default(1)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  station      Station       @relation(fields: [stationId], references: [id], onDelete: Restrict)
  businessUnit BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  agent        Agent?        @relation(fields: [agentId], references: [id], onDelete: Restrict)

  @@unique([companyId, bookingNumber])
  @@index([companyId, pnr])
  @@index([stationId, travelDate, status])
  @@map("ticket_bookings")
}

model GeneratedDocument {
  id             String         @id @default(cuid())
  companyId      String
  stationId      String?
  documentType   String
  documentNumber String
  sourceType     String
  sourceId       String
  templateKey    String
  version        Int            @default(1)
  status         DocumentStatus @default(GENERATING)
  objectKey      String?
  mimeType       String?
  checksum       String?
  generatedById  String
  generatedAt    DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  company Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  station Station?     @relation(fields: [stationId], references: [id], onDelete: Restrict)
  prints  PrintEvent[]

  @@unique([companyId, documentNumber, version])
  @@index([sourceType, sourceId])
  @@map("generated_documents")
}

model PrintEvent {
  id          String   @id @default(cuid())
  documentId  String
  printedById String
  printerName String?
  format      String
  reason      String?
  printedAt   DateTime @default(now()) @db.Timestamptz(3)

  document GeneratedDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([documentId, printedAt])
  @@map("print_events")
}
