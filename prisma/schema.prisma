generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING_INVITE
  ACTIVE
  LOCKED
  DISABLED
}

enum StationStatus {
  ACTIVE
  DISABLED
}

enum RoleScope {
  COMPANY
  BUSINESS_UNIT
  STATION
}

enum LoginAttemptResult {
  SUCCESS
  INVALID_CREDENTIALS
  LOCKED
  DISABLED
  RATE_LIMITED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

enum AttachmentStatus {
  PENDING_UPLOAD
  ACTIVE
  QUARANTINED
  DELETED
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
  SECRET_REFERENCE
}

enum PaymentMethodType {
  CASH
  POS_TERMINAL
  BANK_TRANSFER
  WALLET
  CREDIT
  OTHER
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  TEMPORARY
  INTERN
  CONSULTANT
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
  RESIGNED
  RETIRED
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum CustomerStatus {
  ACTIVE
  DISABLED
  MERGED
}

enum CustomerContactType {
  PHONE
  EMAIL
  ADDRESS
}

enum CustomerIdentifierType {
  NATIONAL_ID
  PASSPORT
  TAX_ID
  PNR
  OTHER
}

enum ProductStatus {
  ACTIVE
  DISCONTINUED
  DISABLED
}

enum PurchaseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum ReceiptStatus {
  DRAFT
  POSTED
  REVERSED
}

enum StockMovementType {
  OPENING
  PURCHASE_RECEIPT
  SALE
  SALE_RETURN
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  DAMAGE
  RETURN_TO_SUPPLIER
  REVERSAL
}

enum TransferStatus {
  REQUESTED
  DISPATCHED
  RECEIVED
  REJECTED
  CANCELLED
}

enum AdjustmentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  POSTED
  REVERSED
}

enum SaleStatus {
  HELD
  POSTED
  PARTIALLY_PAID
  PAID
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  PENDING_APPROVAL
  POSTED
  REJECTED
  REVERSED
}

enum CargoStatus {
  DRAFT
  PROCESSING
  LABELLED
  DISPATCHED
  IN_TRANSIT
  ARRIVED
  DELIVERED
  ON_HOLD
  CANCELLED
}

enum AgentStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum WalletEntryType {
  DEPOSIT
  SALE_DEBIT
  REFUND_CREDIT
  ADJUSTMENT_CREDIT
  ADJUSTMENT_DEBIT
  REVERSAL
}

enum FinanceDirection {
  DEBIT
  CREDIT
}

enum PostingStatus {
  DRAFT
  PENDING_APPROVAL
  POSTED
  RECONCILED
  REVERSED
  REJECTED
}

enum CashSessionStatus {
  OPEN
  CLOSED
  RECONCILED
}

enum BookingStatus {
  RESERVED
  TICKETED
  CANCELLED
  REFUNDED
}

enum DocumentStatus {
  GENERATING
  READY
  FAILED
  SUPERSEDED
}

model Company {
  id            String   @id @default(cuid())
  code          String   @unique
  legalName     String
  displayName   String
  email         String?
  phone         String?
  address           String?
  logoObjectKey     String?
  logoDarkObjectKey String?
  timezone          String   @default("Africa/Lagos")
  currencyCode      String   @default("NGN")
  locale            String   @default("en-NG")
  taxRate           Decimal  @default(0) @db.Decimal(7, 4)
  isActive          Boolean  @default(true)
  version       Int      @default(1)
  createdById   String?
  updatedById   String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  businessUnits        BusinessUnit[]
  stations             Station[]
  users                User[]
  roles                Role[]
  sequences            Sequence[]
  auditEvents          AuditEvent[]
  approvals            ApprovalRequest[]
  attachments          Attachment[]
  notifications        Notification[]
  settings             SystemSetting[]
  outboxEvents         OutboxEvent[]
  idempotencyKeys      IdempotencyKey[]
  paymentMethods       PaymentMethod[]
  departments          Department[]
  positions            Position[]
  staff                Staff[]
  attendance           StaffAttendance[]
  customers            Customer[]
  customerMerges       CustomerMerge[]
  productCategories    ProductCategory[]
  unitsOfMeasure       UnitOfMeasure[]
  suppliers            Supplier[]
  products             Product[]
  stockMovements       StockMovement[]
  purchaseOrders       PurchaseOrder[]
  goodsReceipts        GoodsReceipt[]
  stockTransfers       StockTransfer[]
  inventoryAdjustments InventoryAdjustment[]
  sales                Sale[]
  payments             Payment[]
  refunds              Refund[]
  cargoShipments       CargoShipment[]
  cargoLocations       CargoLocation[]
  agents               Agent[]
  walletEntries        WalletEntry[]
  financialAccounts    FinancialAccount[]
  financialCategories  FinancialCategory[]
  cashbookEntries      CashbookEntry[]
  financialPeriods     FinancialPeriod[]
  reconciliations      Reconciliation[]
  ticketBookings       TicketBooking[]
  generatedDocuments   GeneratedDocument[]

  @@map("companies")
}

model BusinessUnit {
  id          String   @id @default(cuid())
  companyId   String
  code        String
  name        String
  description String?
  isActive    Boolean  @default(true)
  version     Int      @default(1)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  stationLinks    StationBusinessUnit[]
  roleAssignments UserRole[]
  userScopes      UserBusinessUnitScope[]
  sequences       Sequence[]
  auditEvents     AuditEvent[]
  approvals       ApprovalRequest[]
  attachments     Attachment[]
  notifications   Notification[]
  settings        SystemSetting[]
  departments     Department[]
  staff           Staff[]
  customers       Customer[]
  purchaseOrders  PurchaseOrder[]
  sales           Sale[]
  cashbookEntries CashbookEntry[]
  ticketBookings  TicketBooking[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("business_units")
}

model Station {
  id             String        @id @default(cuid())
  companyId      String
  code           String
  name           String
  legalName      String?
  email          String?
  phone          String?
  address        String?
  city           String?
  state          String?
  countryCode    String        @default("NG")
  timezone       String        @default("Africa/Lagos")
  status         StationStatus @default(ACTIVE)
  openedAt       DateTime?     @db.Date
  disabledAt     DateTime?     @db.Timestamptz(3)
  disabledReason String?
  version        Int           @default(1)
  createdById    String?
  updatedById    String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  company              Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  businessUnits        StationBusinessUnit[]
  managerHistory       StationManagerAssignment[]
  roleAssignments      UserRole[]
  userScopes           UserStationScope[]
  sequences            Sequence[]
  auditEvents          AuditEvent[]
  approvals            ApprovalRequest[]
  attachments          Attachment[]
  notifications        Notification[]
  settings             SystemSetting[]
  staffHome            Staff[]                    @relation("StaffHomeStation")
  staffAssignments     StaffStationAssignment[]
  customers            Customer[]
  inventoryBalances    InventoryBalance[]
  stockMovements       StockMovement[]
  purchaseOrders       PurchaseOrder[]
  goodsReceipts        GoodsReceipt[]
  transfersOut         StockTransfer[]            @relation("TransferOrigin")
  transfersIn          StockTransfer[]            @relation("TransferDestination")
  inventoryAdjustments InventoryAdjustment[]
  posSessions          POSSession[]
  sales                Sale[]
  payments             Payment[]
  refunds              Refund[]
  cargoShipments       CargoShipment[]
  agents               Agent[]
  walletEntries        WalletEntry[]
  cashbookEntries      CashbookEntry[]
  cashSessions         CashSession[]
  ticketBookings       TicketBooking[]
  generatedDocuments   GeneratedDocument[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@map("stations")
}

model StationBusinessUnit {
  stationId      String
  businessUnitId String
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  station      Station      @relation(fields: [stationId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)

  @@id([stationId, businessUnitId])
  @@index([businessUnitId])
  @@map("station_business_units")
}

model User {
  id                    String     @id @default(cuid())
  companyId             String
  name                  String?
  firstName             String
  lastName              String
  username              String     @unique
  email                 String?    @unique
  emailVerified         DateTime?  @db.Timestamptz(3)
  phone                 String?
  image                 String?
  passwordHash          String?
  passwordChangedAt     DateTime?  @db.Timestamptz(3)
  mustChangePassword    Boolean    @default(true)
  status                UserStatus @default(PENDING_INVITE)
  failedLoginCount      Int        @default(0)
  lockedUntil           DateTime?  @db.Timestamptz(3)
  lastLoginAt           DateTime?  @db.Timestamptz(3)
  lastLoginIp           String?
  securityVersion       Int        @default(1)
  twoFactorEnabled      Boolean    @default(false)
  twoFactorSecretCipher String?
  version               Int        @default(1)
  createdById           String?
  updatedById           String?
  createdAt             DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime   @updatedAt @db.Timestamptz(3)

  company             Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  accounts            Account[]
  sessions            Session[]
  roleAssignments     UserRole[]
  stationScopes       UserStationScope[]
  businessUnitScopes  UserBusinessUnitScope[]
  managedStations     StationManagerAssignment[]
  auditEvents         AuditEvent[]               @relation("AuditActor")
  approvalsRequested  ApprovalRequest[]          @relation("ApprovalRequester")
  approvalsAssigned   ApprovalRequest[]          @relation("ApprovalAssignee")
  approvalsDecided    ApprovalRequest[]          @relation("ApprovalDecider")
  attachmentsUploaded Attachment[]
  notifications       Notification[]
  notificationPrefs   NotificationPreference[]
  idempotencyKeys     IdempotencyKey[]
  loginAttempts       LoginAttempt[]
  staffProfile        Staff?

  @@index([companyId, status])
  @@index([companyId, lastName, firstName])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id              String    @id @default(cuid())
  sessionToken    String    @unique
  userId          String
  expires         DateTime  @db.Timestamptz(3)
  securityVersion Int       @default(1)
  ipAddress       String?
  userAgent       String?
  lastSeenAt      DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt       DateTime? @db.Timestamptz(3)
  revokedReason   String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expires])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  purpose    String    @default("EMAIL_VERIFICATION")
  expires    DateTime  @db.Timestamptz(3)
  usedAt     DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([identifier, token])
  @@index([token, expires])
  @@map("verification_tokens")
}

model Role {
  id          String    @id @default(cuid())
  companyId   String
  code        String
  name        String
  description String?
  scope       RoleScope @default(STATION)
  isSystem    Boolean   @default(false)
  isActive    Boolean   @default(true)
  version     Int       @default(1)
  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  users       UserRole[]
  permissions RolePermission[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  module      String
  action      String
  description String
  isSensitive Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  roles RolePermission[]

  @@index([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  grantedById  String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id             String    @id @default(cuid())
  userId         String
  roleId         String
  stationId      String?
  businessUnitId String?
  validFrom      DateTime  @default(now()) @db.Timestamptz(3)
  validUntil     DateTime? @db.Timestamptz(3)
  assignedById   String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  station      Station?      @relation(fields: [stationId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, stationId, businessUnitId])
  @@index([userId, validUntil])
  @@index([stationId])
  @@index([businessUnitId])
  @@map("user_roles")
}

model UserStationScope {
  id           String   @id @default(cuid())
  userId       String
  stationId    String
  canView      Boolean  @default(true)
  canOperate   Boolean  @default(false)
  isPrimary    Boolean  @default(false)
  assignedById String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([userId, stationId])
  @@index([stationId, canOperate])
  @@map("user_station_scopes")
}

model UserBusinessUnitScope {
  id             String   @id @default(cuid())
  userId         String
  businessUnitId String
  canView        Boolean  @default(true)
  canOperate     Boolean  @default(false)
  assignedById   String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)

  @@unique([userId, businessUnitId])
  @@index([businessUnitId, canOperate])
  @@map("user_business_unit_scopes")
}

model StationManagerAssignment {
  id           String    @id @default(cuid())
  stationId    String
  managerId    String
  startsAt     DateTime  @default(now()) @db.Timestamptz(3)
  endsAt       DateTime? @db.Timestamptz(3)
  assignedById String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)
  manager User    @relation(fields: [managerId], references: [id], onDelete: Restrict)

  @@index([stationId, endsAt])
  @@index([managerId])
  @@map("station_manager_assignments")
}

model LoginAttempt {
  id         String             @id @default(cuid())
  userId     String?
  identifier String
  result     LoginAttemptResult
  ipAddress  String?
  userAgent  String?
  requestId  String?
  occurredAt DateTime           @default(now()) @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([identifier, occurredAt])
  @@index([ipAddress, occurredAt])
  @@map("login_attempts")
}

model Sequence {
  id             String   @id @default(cuid())
  companyId      String
  stationId      String?
  businessUnitId String?
  scopeKey       String
  documentType   String
  dateKey        String   @default("")
  prefix         String
  nextValue      BigInt   @default(1)
  padding        Int      @default(6)
  version        Int      @default(1)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  station      Station?      @relation(fields: [stationId], references: [id], onDelete: Restrict)
  businessUnit BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)

  @@unique([companyId, scopeKey, documentType, dateKey])
  @@index([stationId, documentType])
  @@map("sequences")
}

model AuditEvent {
  id             String       @id @default(cuid())
  companyId      String
  actorId        String?
  stationId      String?
  businessUnitId String?
  action         String
  entityType     String
  entityId       String?
  outcome        AuditOutcome @default(SUCCESS)
  reason         String?
  requestId      String?
  ipAddress      String?
  userAgent      String?
  before         Json?
  after          Json?
  metadata       Json?
  previousHash   String?
  eventHash      String       @unique
  occurredAt     DateTime     @default(now()) @db.Timestamptz(3)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actor        User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  station      Station?      @relation(fields: [stationId], references: [id], onDelete: SetNull)
  businessUnit BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)

  @@index([companyId, occurredAt])
  @@index([actorId, occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@index([stationId, occurredAt])
  @@index([companyId, eventHash])
  @@map("audit_events")
}

model ApprovalRequest {
  id              String         @id @default(cuid())
  companyId       String
  stationId       String?
  businessUnitId  String?
  entityType      String
  entityId        String
  action          String
  status          ApprovalStatus @default(PENDING)
  requestedById   String
  assignedToId    String?
  assignedRoleKey String?
  decidedById     String?
  requestReason   String
  decisionReason  String?
  payload         Json?
  requestedAt     DateTime       @default(now()) @db.Timestamptz(3)
  decidedAt       DateTime?      @db.Timestamptz(3)
  expiresAt       DateTime?      @db.Timestamptz(3)
  version         Int            @default(1)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  station      Station?      @relation(fields: [stationId], references: [id], onDelete: Restrict)
  businessUnit BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  requestedBy  User          @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  assignedTo   User?         @relation("ApprovalAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  decidedBy    User?         @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([companyId, status, requestedAt])
  @@index([assignedToId, status])
  @@index([entityType, entityId])
  @@map("approval_requests")
}

model Attachment {
  id              String           @id @default(cuid())
  companyId       String
  stationId       String?
  businessUnitId  String?
  uploadedById    String
  module          String
  recordType      String
  recordId        String
  bucket          String
  objectKey       String           @unique
  originalName    String
  mimeType        String
  sizeBytes       BigInt
  checksumSha256  String?
  encryptionKeyId String?
  status          AttachmentStatus @default(PENDING_UPLOAD)
  uploadedAt      DateTime?        @db.Timestamptz(3)
  deletedAt       DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  station      Station?      @relation(fields: [stationId], references: [id], onDelete: Restrict)
  businessUnit BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  uploadedBy   User          @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([recordType, recordId])
  @@index([companyId, module, createdAt])
  @@map("attachments")
}

model Notification {
  id             String             @id @default(cuid())
  companyId      String
  recipientId    String
  stationId      String?
  businessUnitId String?
  type           String
  severity       String             @default("INFO")
  title          String
  message        String
  href           String?
  entityType     String?
  entityId       String?
  status         NotificationStatus @default(UNREAD)
  readAt         DateTime?          @db.Timestamptz(3)
  archivedAt     DateTime?          @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  recipient    User          @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  station      Station?      @relation(fields: [stationId], references: [id], onDelete: SetNull)
  businessUnit BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)

  @@index([recipientId, status, createdAt])
  @@index([companyId, type, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id        String              @id @default(cuid())
  userId    String
  type      String
  channel   NotificationChannel
  enabled   Boolean             @default(true)
  quietFrom String?
  quietTo   String?
  createdAt DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt DateTime            @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, channel])
  @@map("notification_preferences")
}

model SystemSetting {
  id             String           @id @default(cuid())
  companyId      String
  stationId      String?
  businessUnitId String?
  scopeKey       String           @default("COMPANY")
  namespace      String
  key            String
  valueType      SettingValueType @default(JSON)
  value          Json
  isSensitive    Boolean          @default(false)
  version        Int              @default(1)
  updatedById    String?
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  station      Station?      @relation(fields: [stationId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)

  @@unique([companyId, scopeKey, namespace, key])
  @@index([stationId, namespace])
  @@index([businessUnitId, namespace])
  @@map("system_settings")
}

model OutboxEvent {
  id            String       @id @default(cuid())
  companyId     String
  aggregateType String
